# --- Database (PostgreSQL) ---
# Local:  postgres://insightiq:insightiq@localhost:5432/insightiq   (docker compose up -d)
# Neon:   copy the *pooled* connection string from the Neon dashboard (host contains -pooler)
DATABASE_URL=
# SSL is automatic for non-local hosts. Only set this to force it on/off.
# DATABASE_SSL=true
# Max connections per server instance (default 3 on Vercel, 10 elsewhere)
# DATABASE_POOL_MAX=3

# --- Login tokens (JWT) ---
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- First administrator ---
# There is no sign-up page. Create the first administrator from the command line:
#   npm run db:create-admin -- you@college.edu "Your Name"
# It prints a generated password once. Every other student and teacher is registered by an
# administrator under Login credentials in the portal.

# --- Email: sends each new person their login (optional) ---
# Without these, the administrator sees each generated password once on screen. The forgot-password
# flow needs no email: an administrator approves it and the person sets a new password on the login page.
# SMTP_URL=smtps://you%40gmail.com:your-app-password@smtp.gmail.com
# APP_URL=https://your-site.example
# MAIL_FROM=SLQG <you@gmail.com>

# --- Website assistant (free): Google Gemini via its OpenAI-compatible API ---
# Get a key, no card needed: https://aistudio.google.com/apikey
LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Other free options: OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# --- Groq (fast, free tier): used first by every AI feature when set ---
# Get a key: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# --- Analytics Copilot fallback: Grok (xAI), tried if the main model fails or is out of quota ---
# Get a key: https://console.x.ai
# GROK_API_KEY=
# GROK_MODEL=grok-4
# GROK_BASE_URL=https://api.x.ai/v1

# --- WhatsApp assistant via Twilio (optional) ---
# Twilio Console > Auth Token. Required for the /api/public/whatsapp webhook; see docs/WHATSAPP.md
# TWILIO_AUTH_TOKEN=
# Only if behind a proxy: the exact public URL you gave Twilio for the webhook
# TWILIO_WEBHOOK_URL=https://your-site.example/api/public/whatsapp
