# --- Database (PostgreSQL) ---
# Local:  postgres://insightiq:insightiq@localhost:5432/insightiq   (docker compose up -d)
# Neon:   copy the *pooled* connection string from the Neon dashboard (host contains -pooler)
DATABASE_URL=
# SSL is automatic for non-local hosts. Only set this to force it on/off.
# DATABASE_SSL=true
# Max connections per server instance (default 3 on Vercel, 10 elsewhere)
# DATABASE_POOL_MAX=3

# --- Login tokens (JWT) ---
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- First administrators ---
# Comma-separated emails. Signing up with one of these makes someone an administrator.
# With no administrator on the site yet, the first Administrator sign-up is also accepted.
# Everyone else starts as a student; administrators grant teacher access in People & roles.
ADMIN_EMAILS=you@college.edu

# --- Password reset emails (optional) ---
# Without these, "Forgot your password?" sends a note to the administrators instead.
# SMTP_URL=smtps://you%40gmail.com:your-app-password@smtp.gmail.com
# APP_URL=https://your-site.example
# MAIL_FROM=Orbit <you@gmail.com>

# --- Website assistant (free): Google Gemini via its OpenAI-compatible API ---
# Get a key, no card needed: https://aistudio.google.com/apikey
LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Other free options: OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# --- Teachers who need no approval (optional) ---
# Comma-separated emails. Signing up in the Teacher workspace with one of these is active at once.
# Anyone else who signs up as a teacher waits for an administrator to approve them.
# TEACHER_EMAILS=teacher1@college.edu,teacher2@college.edu

# --- WhatsApp assistant via Twilio (optional) ---
# Twilio Console > Auth Token. Required for the /api/public/whatsapp webhook; see docs/WHATSAPP.md
# TWILIO_AUTH_TOKEN=
# Only if behind a proxy: the exact public URL you gave Twilio for the webhook
# TWILIO_WEBHOOK_URL=https://your-site.example/api/public/whatsapp
